
CFLAGS=-Wall -std=gnu99
INCLUDES=-I./inc

BUFMGR_SRCS=src/errExit.c src/semaphore.c src/shared_memory.c src/page.c src/bufmgr.c
BACKEND_SRCS=src/errExit.c src/semaphore.c src/shared_memory.c src/page.c src/report.c src/backend.c

BUFMGR_OBJS=$(BUFMGR_SRCS:.c=.o)
BACKEND_OBJS=$(BACKEND_SRCS:.c=.o)
SRCS=$(sort $(BUFMGR_SRCS) $(BACKEND_SRCS))
OBJS=$(SRCS:.c=.o)

all: bufmgr backend

bufmgr: $(BUFMGR_OBJS)
	@echo "Making executable: "$@
	@$(CC) $^ -o $@

backend: $(BACKEND_OBJS)
	@echo "Making executable: "$@
	@$(CC) $^ -o $@

.c.o:
	@echo "Compiling: "$<
	@$(CC) $(CFLAGS) $(INCLUDES) -c $< -o $@

# compile_commands.json tells the editor how each file is compiled
# (include paths, flags): generated by make itself, before compiling
$(OBJS): | compile_commands.json

compile_commands.json: Makefile
	@echo "Generating: "$@
	@sep=""; printf "[" > $@; \
	for src in $(SRCS); do \
		printf '%s\n  {"directory": "%s", "file": "%s", "command": "%s"}' "$$sep" \
			"$(CURDIR)" "$$src" "$(CC) $(CFLAGS) $(INCLUDES) -c $$src -o $${src%.c}.o" >> $@; \
		sep=","; \
	done; \
	printf '\n]\n' >> $@

.PHONY: all clean

clean:
	@rm -f src/*.o bufmgr backend
	@echo "Removed object files and executables..."
