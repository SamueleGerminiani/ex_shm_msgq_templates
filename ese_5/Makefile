
CFLAGS=-Wall -std=gnu99
INCLUDES=-I./inc

BACKEND_SRCS=src/errExit.c src/shared_memory.c src/result.c src/backend.c
CLIENT_SRCS=src/errExit.c src/shared_memory.c src/result.c src/report.c src/client.c

BACKEND_OBJS=$(BACKEND_SRCS:.c=.o)
CLIENT_OBJS=$(CLIENT_SRCS:.c=.o)
SRCS=$(sort $(BACKEND_SRCS) $(CLIENT_SRCS))
OBJS=$(SRCS:.c=.o)

all: backend client

backend: $(BACKEND_OBJS)
	@echo "Making executable: "$@
	@$(CC) $^ -o $@

client: $(CLIENT_OBJS)
	@echo "Making executable: "$@
	@$(CC) $^ -o $@

.c.o:
	@echo "Compiling: "$<
	@$(CC) $(CFLAGS) $(INCLUDES) -c $< -o $@

# compile_commands.json tells the editor how each file is compiled
# (include paths, flags): generated by make itself, before compiling
$(OBJS): | compile_commands.json

compile_commands.json: Makefile
	@echo "Generating: "$@
	@sep=""; printf "[" > $@; \
	for src in $(SRCS); do \
		printf '%s\n  {"directory": "%s", "file": "%s", "command": "%s"}' "$$sep" \
			"$(CURDIR)" "$$src" "$(CC) $(CFLAGS) $(INCLUDES) -c $$src -o $${src%.c}.o" >> $@; \
		sep=","; \
	done; \
	printf '\n]\n' >> $@

.PHONY: all clean

clean:
	@rm -f src/*.o backend client
	@echo "Removed object files and executables..."
