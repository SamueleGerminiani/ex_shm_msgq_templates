
# Part 1 - shared memory and message queues: one small program per idea
CFLAGS=-Wall -std=gnu99
INCLUDES=-I./inc

PROGS=stats_demo race_demo queue_demo idle_demo
SRCS=src/errExit.c src/semaphore.c src/stats.c src/race.c src/queue.c src/idle.c
OBJS=$(SRCS:.c=.o)

all: $(PROGS)

%_demo: src/%.o src/errExit.o src/semaphore.o
	@echo "Making executable: "$@
	@$(CC) $^ -o $@

src/%.o: src/%.c
	@echo "Compiling: "$<
	@$(CC) $(CFLAGS) $(INCLUDES) -c $< -o $@

# compile_commands.json tells the editor how each file is compiled
# (include paths, flags): generated by make itself, before compiling
$(OBJS): | compile_commands.json

compile_commands.json: Makefile
	@echo "Generating: "$@
	@sep=""; printf "[" > $@; \
	for src in $(SRCS); do \
		printf '%s\n  {"directory": "%s", "file": "%s", "command": "%s"}' "$$sep" \
			"$(CURDIR)" "$$src" "$(CC) $(CFLAGS) $(INCLUDES) -c $$src -o $${src%.c}.o" >> $@; \
		sep=","; \
	done; \
	printf '\n]\n' >> $@

.PHONY: all clean
.SECONDARY:

clean:
	@rm -f src/*.o $(PROGS)
	@echo "Removed object files and executables..."
